{
  "cluster": "REPLACE_ECS_CLUSTER",
  "serviceName": "REPLACE_DASHBOARD_SERVICE",
  "taskDefinition": "REPLACE_DASHBOARD_TASK_REVISION",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "platformVersion": "1.4.0",
  "enableExecuteCommand": false,
  "deploymentConfiguration": {
    "minimumHealthyPercent": 100,
    "maximumPercent": 200,
    "deploymentCircuitBreaker": {
