  "networkConfiguration": {
    "awsvpcConfiguration": {
      "assignPublicIp": "ENABLED",
      "subnets": [
        "REPLACE_PUBLIC_SUBNET_ID"
      ],
      "securityGroups": [
        "REPLACE_DASHBOARD_SG_ID"
      ]
    }
  },
  "serviceRegistries": [
    {
      "registryArn": "REPLACE_DASHBOARD_DISCOVERY_ARN"
    }
  ]
}
