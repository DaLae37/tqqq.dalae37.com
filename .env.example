# Public demo always uses isolated synthetic fixtures. No engine calls.
DATA_ADAPTER=disabled
# Protected dashboard: scrypt hash generated with scripts/hash-password.mjs.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
# Supply private connection values outside the repository.
ENGINE_API_BASE_URL=
ENGINE_API_ALLOWED_HOST=
ENGINE_READ_API_TOKEN=
# Production retrieves the read token through the Dashboard Task Role.
ENGINE_READ_API_TOKEN_SECRET_ARN=
AWS_REGION=ap-northeast-2
# HTTPS by default. vpc-http requires a verified private namespace and SG isolation.
ENGINE_API_TRANSPORT=tls
ENGINE_PRIVATE_DNS_SUFFIX=
# Trust private CA with NODE_EXTRA_CA_CERTS; never disable certificate checks.
